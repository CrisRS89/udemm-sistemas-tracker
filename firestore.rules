rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // users/{userId}/careers/{careerId}
    //   version: int (required, exactly 3)
    //   careerId: string (required, supported path career)
    //   subjectsJson: string (required, JSON, 2..200000 bytes)
    //   strictMode: bool (required)
    //   updatedAt: timestamp (required, server timestamp)
    //
    // No PII, public profiles, roles or sharing metadata are stored.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSupportedCareer(careerId) {
      return careerId in [
        'sistemas',
        'electronica',
        'industrial',
        'mecanica',
        'electromecanica'
      ];
    }

    function isValidPlan(data, careerId) {
      return data.keys().hasAll([
          'version',
          'careerId',
          'subjectsJson',
          'strictMode',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'version',
          'careerId',
          'subjectsJson',
          'strictMode',
          'updatedAt'
        ])
        && data.version is int
        && data.version == 3
        && data.careerId is string
        && data.careerId == careerId
        && isSupportedCareer(careerId)
        && data.subjectsJson is string
        && data.subjectsJson.size() >= 2
        && data.subjectsJson.size() <= 200000
        && data.strictMode is bool
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId}/careers/{careerId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidPlan(request.resource.data, careerId);
      allow update: if isOwner(userId)
        && isValidPlan(request.resource.data, careerId)
        && request.resource.data.careerId == resource.data.careerId;
    }

    // Todo lo demás, incluidos los antiguos shared_plans anónimos, queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
